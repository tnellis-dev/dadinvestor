---
// src/components/Footer.astro
const currentYear = new Date().getFullYear();
---
<footer class="bg-[#0F291E] text-slate-400 py-12 px-4 border-t border-emerald-950">
  <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-4 gap-8 mb-8">
    
    <!-- Col 1: About -->
    <div class="space-y-3 md:col-span-2">
      <div class="flex items-center gap-2 font-bold text-lg text-white">
        <span class="w-6 h-6 rounded bg-[#10B981] text-[#0F291E] flex items-center justify-center text-xs font-black">
          $
        </span>
        DadInvestor
      </div>
      <p class="text-sm text-slate-300 leading-relaxed max-w-md">
        Independent financial education and practical digital tools designed to help everyday Australian parents plan their family's wealth.
      </p>
    </div>

    <!-- Col 2: Quick Links -->
    <div class="space-y-3">
      <p class="text-xs font-bold text-white uppercase tracking-wider">Hubs</p>
      <ul class="space-y-2 text-sm">
        <li><a href="/calculators-and-tools" class="hover:text-[#10B981] transition">Calculators & Tools</a></li>
        <li><a href="/etfs-investing" class="hover:text-[#10B981] transition">ETFs & Investing</a></li>
        <li><a href="/banking-savings" class="hover:text-[#10B981] transition">Banking & Savings</a></li>
      </ul>
    </div>

    <!-- Col 3: Holding Entity -->
    <div class="space-y-3">
      <p class="text-xs font-bold text-white uppercase tracking-wider">Network</p>
      <ul class="space-y-2 text-sm">
        <li><a href="/about" class="hover:text-[#10B981] transition">About DadInvestor</a></li>
        <li><a href="https://searchlightweb.com.au" target="_blank" rel="noopener" class="hover:text-[#10B981] transition">Design by Searchlight Web</a></li>
        <li>Part of <a href="https://ellismedia.com.au" target="_blank" rel="noopener" class="hover:text-[#10B981] transition">EllisMedia</a></li>
      </ul>
    </div>

  </div>

  <!-- Copyright & Disclaimer Note -->
  <div class="max-w-7xl mx-auto pt-8 border-t border-emerald-900/40 text-xs text-slate-500 flex flex-col md:flex-row justify-between gap-4">
    <p>© {currentYear} DadInvestor.com.au. All rights reserved.</p>
  </div>
</footer>