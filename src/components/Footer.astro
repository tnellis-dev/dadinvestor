
---
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-[var(--di-line)] bg-[var(--di-cream)] px-5 py-14 text-[var(--di-body)] lg:px-8">

  <div class="mx-auto mb-10 grid max-w-7xl grid-cols-1 gap-10 md:grid-cols-4">

    <!-- About -->
    <div class="space-y-4 md:col-span-2">
      <a
        href="/"
        class="inline-block font-[var(--di-font-heading)] text-3xl font-semibold tracking-[-0.04em] text-[var(--di-ink)] no-underline"
      >
        DadInvestor
      </a>

      <p class="max-w-xl text-xl leading-relaxed">
        Independent financial education and practical digital tools designed to help everyday Australian parents plan their family's wealth.
      </p>
    </div>

    <!-- Explore -->
    <div class="space-y-4">
      <h2 class="font-[var(--di-font-heading)] text-2xl font-semibold text-[var(--di-ink)]">
        Explore
      </h2>

      <ul class="space-y-3 text-xl">
        <li><a href="/articles" class="no-underline transition-colors hover:text-[var(--di-forest)]">Articles</a></li>
        <li><a href="/calculators-and-tools" class="no-underline transition-colors hover:text-[var(--di-forest)]">Calculators &amp; Tools</a></li>
        <li><a href="/etfs-investing" class="no-underline transition-colors hover:text-[var(--di-forest)]">ETFs &amp; Investing</a></li>
        <li><a href="/banking-savings" class="no-underline transition-colors hover:text-[var(--di-forest)]">Banking &amp; Savings</a></li>
      </ul>
    </div>

    <!-- About / Network -->
    <div class="space-y-4">
      <h2 class="font-[var(--di-font-heading)] text-2xl font-semibold text-[var(--di-ink)]">
        About
      </h2>

      <ul class="space-y-3 text-xl">
        <li><a href="/about" class="no-underline transition-colors hover:text-[var(--di-forest)]">About DadInvestor</a></li>

        <li>
          <a
            href="https://searchlightweb.com.au"
            target="_blank"
            rel="noopener"
            class="no-underline transition-colors hover:text-[var(--di-forest)]"
          >
            Design by Searchlight Web
          </a>
        </li>

        <li>
          Part of
          <a
            href="https://ellismedia.com.au"
            target="_blank"
            rel="noopener"
            class="no-underline transition-colors hover:text-[var(--di-forest)]"
          >
            EllisMedia
          </a>
        </li>
      </ul>
    </div>

  </div>

  <!-- Copyright -->
  <div class="mx-auto flex max-w-7xl flex-col justify-between gap-3 border-t border-[var(--di-line)] pt-6 text-xl text-[var(--di-muted)] md:flex-row">
    <p>© {currentYear} DadInvestor.com.au. All rights reserved.</p>
  </div>

</footer>
