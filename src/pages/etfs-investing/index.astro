
---
import { sanityClient } from '../../lib/sanity';
import BaseLayout from '../../layouts/BaseLayout.astro';

const categoryInfo = {
  title: 'Investing & ETFs',
  description:
    'Plain-English ETF guides, index fund portfolio breakdowns, and long-term wealth strategies built specifically for everyday Australian parents.',
};

// Fetch articles from Sanity
const articles = await sanityClient.fetch(`
  *[_type == "article" && category == "ETFs & Investing"] | order(publishedAt desc) {
    title,
    subtitle,
    "slug": slug.current,
    publishedAt,
    dateModified,
    readTimeMinutes,
    featured,
    heroImage,
    heroImageAlt,
    "imageUrl": heroImage.asset->url
  }
`);

// Featured articles (maximum 3)
const featuredArticles = articles
  .filter((article) => article.featured)
  .slice(0, 3);

// Identify which articles are actually displayed as featured
const featuredSlugs = new Set(
  featuredArticles.map((article) => article.slug)
);

// Remaining articles, newest first
const latestArticles = articles.filter(
  (article) => !featuredSlugs.has(article.slug)
);

// Format dates
const formatDate = (date) => {
  if (!date) return '';

  return new Date(date).toLocaleDateString('en-AU', {
    month: 'long',
    year: 'numeric',
  });
};

// Structured data
const hubSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'ETFs & Long-Term Investing',
  description: categoryInfo.description,
  url: 'https://www.dadinvestor.com.au/etfs-investing/',
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: articles.map((article, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: article.title,
      url: `https://www.dadinvestor.com.au/${article.slug}`,
    })),
  },
};
---

<BaseLayout
  title="ETFs & Investing Hub"
  description="Plain-English ETF guides, broker reviews, and long-term investment strategies designed for Australian parents."
>
  <script type="application/ld+json" set:html={JSON.stringify(hubSchema)} />

  <!-- Hub Header Hero Banner -->
  <header class="bg-[#164B35] text-white py-16 px-4 border-b border-[#103B2A]">
<div class="max-w-[1168px] mx-auto space-y-4">      <div class="flex items-center gap-3">
        <span class="bg-white/10 text-[#F8F3EA] font-semibold text-sm uppercase tracking-wider px-3 py-1 rounded-full border border-white/20">
          Category Hub
        </span>
        <span class="text-[#D5E2D8] text-base">ETFs & Investing</span>
      </div>

      <h1 class="text-3xl md:text-5xl font-extrabold tracking-tight leading-tight text-white max-w-4xl">
        ETFs & Long-Term Investing
      </h1>

      <p class="text-lg text-[#E1E8E2] leading-relaxed font-normal max-w-3xl">
        Cut through the corporate jargon. Explore independent, data-driven guides on building a low-cost, set-and-forget portfolio on the ASX.
      </p>
    </div>
  </header>

  <!-- Main Content Area -->
  <main class="bg-[#F8F3EA] py-16 px-4">
<div class="max-w-[1168px] mx-auto space-y-4">
      <!-- Featured Articles -->
      {featuredArticles.length > 0 && (
        <section class="space-y-6">
          <div class="flex items-end justify-between gap-4">
            <div>
              <p class="text-base font-semibold uppercase tracking-wider text-[#164B35]">
                Start here
              </p>
              <h2 class="text-2xl md:text-3xl font-bold text-[#18251F]">
                Featured guides
              </h2>
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 items-stretch">
            {featuredArticles.map((article) => (
              <article class="bg-[#FFFCF6] rounded-2xl border border-[#E3D8C8] overflow-hidden shadow-sm hover:border-[#164B35]/50 transition flex flex-col justify-between">
                <div>
                  <!-- Article Image -->
                  <div class="aspect-[16/9] overflow-hidden bg-[#EAE2D5] border-b border-[#E3D8C8]">
                    {article.imageUrl && (
                      <a href={`/${article.slug}`} class="block w-full h-full">
                        <img
                          src={article.imageUrl}
                          alt={article.heroImageAlt || article.title}
                          loading="lazy"
                          class="w-full h-full object-cover hover:scale-105 transition duration-500"
                        />
                      </a>
                    )}
                  </div>

                  <!-- Card Body -->
                  <div class="p-6 space-y-3">
                    <div class="flex items-center gap-2 flex-wrap">
                      {article.readTimeMinutes && (
                        <span class="text-sm font-semibold text-[#164B35] bg-[#EAE2D5] px-2.5 py-1 rounded-md">
                          {article.readTimeMinutes} min read
                        </span>
                      )}

                      {article.publishedAt && (
                        <span class="text-base text-[#626B64]">
                          {formatDate(article.publishedAt)}
                        </span>
                      )}
                    </div>

                    <h3 class="text-xl font-bold text-[#18251F] leading-snug">
                      <a href={`/${article.slug}`} class="hover:text-[#164B35] transition">
                        {article.title}
                      </a>
                    </h3>

                    {article.subtitle && (
                      <p class="text-lg text-[#26312B] leading-relaxed">
                        {article.subtitle}
                      </p>
                    )}
                  </div>
                </div>

                <!-- Card Footer -->
                <div class="p-6 pt-0">
                  <a
                    href={`/${article.slug}`}
                    class="inline-flex items-center gap-1.5 text-base font-bold text-[#164B35] hover:text-[#103B2A] transition"
                  >
                    Read Full Guide →
                  </a>
                </div>
              </article>
            ))}
          </div>
        </section>
      )}

      <!-- Latest Articles -->
      <section class="space-y-6">
        <div>
          <p class="text-base font-semibold uppercase tracking-wider text-[#164B35]">
            Explore the library
          </p>
          <h2 class="text-2xl md:text-3xl font-bold text-[#18251F]">
            Latest articles
          </h2>
        </div>

        {latestArticles.length > 0 ? (
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 items-stretch">
            {latestArticles.map((article) => (
              <article class="bg-[#FFFCF6] rounded-2xl border border-[#E3D8C8] overflow-hidden shadow-sm hover:border-[#164B35]/50 transition flex flex-col justify-between">
                <div>
                  <!-- Article Image -->
                  <div class="aspect-[16/9] overflow-hidden bg-[#EAE2D5] border-b border-[#E3D8C8]">
                    {article.imageUrl && (
                      <a href={`/${article.slug}`} class="block w-full h-full">
                        <img
                          src={article.imageUrl}
                          alt={article.heroImageAlt || article.title}
                          loading="lazy"
                          class="w-full h-full object-cover hover:scale-105 transition duration-500"
                        />
                      </a>
                    )}
                  </div>

                  <!-- Card Body -->
                  <div class="p-6 space-y-3">
                    <div class="flex items-center gap-2 flex-wrap">
                      {article.readTimeMinutes && (
                        <span class="text-sm font-semibold text-[#164B35] bg-[#EAE2D5] px-2.5 py-1 rounded-md">
                          {article.readTimeMinutes} min read
                        </span>
                      )}

                      {article.publishedAt && (
                        <span class="text-base text-[#626B64]">
                          {formatDate(article.publishedAt)}
                        </span>
                      )}
                    </div>

                    <h3 class="text-xl font-bold text-[#18251F] leading-snug">
                      <a href={`/${article.slug}`} class="hover:text-[#164B35] transition">
                        {article.title}
                      </a>
                    </h3>

                    {article.subtitle && (
                      <p class="text-lg text-[#26312B] leading-relaxed">
                        {article.subtitle}
                      </p>
                    )}
                  </div>
                </div>

                <!-- Card Footer -->
                <div class="p-6 pt-0">
                  <a
                    href={`/${article.slug}`}
                    class="inline-flex items-center gap-1.5 text-base font-bold text-[#164B35] hover:text-[#103B2A] transition"
                  >
                    Read Full Guide →
                  </a>
                </div>
              </article>
            ))}
          </div>
        ) : (
          <p class="text-lg text-[#626B64]">
            More articles coming soon.
          </p>
        )}
      </section>

      <!-- Bottom Flagship Tool Banner -->
      <div class="bg-[#103B2A] text-white rounded-2xl p-8 md:p-10 border border-[#164B35] shadow-lg flex flex-col md:flex-row items-center justify-between gap-6">
        <div class="space-y-2 max-w-xl">
          <span class="text-base uppercase tracking-wider text-[#D5E2D8] font-bold">
            Interactive Tool
          </span>

          <h3 class="text-2xl font-bold tracking-tight !text-[#FFFCF6]">
  Map Your Wealth in 3 Minutes
</h3>

          <p class="text-lg text-[#E1E8E2] leading-relaxed">
            Test how regular monthly ETF contributions compound over a 10, 20, or 30-year horizon against your family budget.
          </p>
        </div>

        <a
  href="/calculators-and-tools/future-wealth-calculator"
  class="shrink-0 bg-[#F8F3EA] !text-[#164B35] font-bold px-6 py-3.5 rounded-xl hover:bg-white transition shadow-sm text-center"
>
  Launch Wealth Map →
</a>
      </div>

    </div>
  </main>
</BaseLayout>
