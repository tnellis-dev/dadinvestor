
---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CompoundInterestCalculator from '../../components/compound/CompoundInterestCalculator';

const toolDetails = {
  title: 'Compound Interest Calculator',
  category: 'Wealth & Investing',
  description: 'See how regular deposits compound over time. Factor in variances to view best-case and worst-case investment scenarios.',
};
---

<BaseLayout
  title={`${toolDetails.title} - Dad Investor`}
  description={toolDetails.description}
>
  <!-- Page Hero -->
  <header class="bg-[#164B35] text-white py-12 px-4 border-b border-[#103B2A]">
    <div class="max-w-[1168px] mx-auto space-y-3">
      <div class="flex items-center gap-3">
        <span class="bg-white/10 text-[#F8F3EA] font-semibold text-sm uppercase tracking-wider px-3 py-1 rounded-full border border-white/20">
          {toolDetails.category}
        </span>
      </div>

      <h1 class="text-3xl md:text-4xl font-extrabold tracking-tight leading-tight !text-[#FFFCF6] max-w-4xl">
        {toolDetails.title}
      </h1>

      <p class="text-lg text-[#E1E8E2] leading-relaxed max-w-3xl">
        {toolDetails.description}
      </p>
    </div>
  </header>

  <!-- Main Content Layout -->
  <main class="bg-[#F8F3EA] py-12 px-4">
    <div class="max-w-[1168px] mx-auto grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-start">

      <!-- Left Column: Calculator -->
      <div class="lg:col-span-8 space-y-8">

        <!-- Introduction -->
        <div class="space-y-4">
          <p class="text-lg text-[#26312B] leading-relaxed">
            Use this calculator to project how your initial capital and regular savings will grow over time through compound interest.
          </p>

          <p class="text-base text-[#626B64] leading-relaxed">
            Adjust your contribution frequencies, compound intervals, and optional variance percentage to explore best and worst-case return scenarios.
          </p>
        </div>

        <!-- React Calculator -->
        <div>
          <CompoundInterestCalculator client:load />
        </div>

      </div>

      <!-- Right Column: Sidebar -->
      <aside class="lg:col-span-4 space-y-8 lg:sticky lg:top-28">

        <div class="bg-[#FFFCF6] border border-[#E3D8C8] rounded-2xl p-6 space-y-4">

          <h3 class="text-base font-bold !text-[#18251F] border-b border-[#E3D8C8] pb-3">
            Other Calculators
          </h3>

          <ul class="space-y-4 text-sm">
            <li>
              <a
                href="/calculators-and-tools/future-wealth-calculator"
                class="text-[#26312B] hover:text-[#164B35] font-medium transition block"
              >
                → Future Wealth Calculator
              </a>
            </li>

            <li>
              <a
                href="/calculators-and-tools/dividend-payment-calculator"
                class="text-[#26312B] hover:text-[#164B35] font-medium transition block"
              >
                → Dividend Payment Calculator
              </a>
            </li>

            <li>
              <a
                href="/calculators-and-tools/mortgage-offset-calculator"
                class="text-[#26312B] hover:text-[#164B35] font-medium transition block"
              >
                → Mortgage Offset Calculator
              </a>
            </li>
          </ul>

        </div>

      </aside>
    </div>
  </main>
</BaseLayout>
