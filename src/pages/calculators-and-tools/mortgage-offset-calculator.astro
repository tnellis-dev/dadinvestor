
---
import BaseLayout from '../../layouts/BaseLayout.astro';

const toolDetails = {
  title: 'Tax-Adjusted Mortgage Offset Calculator',
  category: 'Debt & Borrowing',
  description: 'Discover the true, tax-free power of your offset account. Compare your guaranteed loan interest savings directly against standard taxed investment returns.',
};
---

<BaseLayout
  title={`${toolDetails.title} - Dad Investor`}
  description={toolDetails.description}
>
  <header class="bg-[#164B35] text-white py-12 px-4">
    <div class="max-w-[1168px] mx-auto space-y-4">
      <div class="flex items-center gap-3">
        <span class="bg-white/10 text-[#FFFCF6] font-semibold text-xs uppercase tracking-wider px-3 py-1 rounded-full border border-white/20">
          {toolDetails.category}
        </span>
      </div>

      <h1 class="text-3xl md:text-4xl font-extrabold tracking-tight leading-tight !text-[#FFFCF6] max-w-4xl">
        {toolDetails.title}
      </h1>

      <p class="text-base !text-[#E5EDE7] leading-relaxed max-w-3xl">
        {toolDetails.description}
      </p>
    </div>
  </header>

  <main class="bg-[#F8F3EA] py-12 md:py-16 px-4">
    <div class="max-w-[1168px] mx-auto grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-start">

      <div class="lg:col-span-8 space-y-8">

        <div class="space-y-5">
          <p class="text-[#26312B] leading-relaxed text-lg">
            When you keep cash in a standard high-interest savings account, the interest earned counts toward your taxable income and gets chipped away by your marginal tax rate.
          </p>

          <p class="text-[#626B64] leading-relaxed">
            Money kept in an active <strong class="text-[#26312B]">mortgage offset account</strong> reduces the principal balance upon which your home loan interest is calculated. Because mortgage interest is paid with post-tax dollars, the savings you receive are effectively 100% tax-free. Enter your numbers below and click calculate to evaluate your true effective return.
          </p>
        </div>

        <!-- Calculator Input & Results -->
        <div class="bg-[#FFFCF6] border border-[#E3D8C8] rounded-2xl p-6 md:p-8 space-y-8">

          <div class="border-b border-[#E3D8C8] pb-4">
            <h2 class="text-xl font-bold !text-[#18251F]">
              Enter Your Mortgage Details
            </h2>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">

            <div>
              <label for="principal" class="block text-sm font-semibold text-[#26312B] mb-2">
                Money Available ($)
              </label>
              <div class="flex items-center rounded-xl border border-[#D8CCBB] bg-[#F8F3EA] px-4 py-3 focus-within:border-[#164B35] focus-within:ring-2 focus-within:ring-[#164B35]/10 transition">
                <span class="text-[#626B64] mr-2">$</span>
                <input
                  type="number"
                  id="principal"
                  value="50000"
                  class="w-full bg-transparent text-[#18251F] font-mono font-medium outline-none min-w-0"
                />
              </div>
            </div>

            <div>
              <label for="interestRate" class="block text-sm font-semibold text-[#26312B] mb-2">
                Mortgage Rate (%)
              </label>
              <div class="flex items-center rounded-xl border border-[#D8CCBB] bg-[#F8F3EA] px-4 py-3 focus-within:border-[#164B35] focus-within:ring-2 focus-within:ring-[#164B35]/10 transition">
                <input
                  type="number"
                  id="interestRate"
                  value="6.0"
                  step="0.05"
                  class="w-full bg-transparent text-[#18251F] font-mono font-medium outline-none min-w-0"
                />
                <span class="text-[#626B64] ml-2">%</span>
              </div>
            </div>

            <div>
              <label for="taxRate" class="block text-sm font-semibold text-[#26312B] mb-2">
                Marginal Tax Rate (%)
              </label>
              <div class="flex items-center rounded-xl border border-[#D8CCBB] bg-[#F8F3EA] px-4 py-3 focus-within:border-[#164B35] focus-within:ring-2 focus-within:ring-[#164B35]/10 transition">
                <input
                  type="number"
                  id="taxRate"
                  value="34.5"
                  step="0.5"
                  class="w-full bg-transparent text-[#18251F] font-mono font-medium outline-none min-w-0"
                />
                <span class="text-[#626B64] ml-2">%</span>
              </div>
            </div>

          </div>

          <button
            id="calculate-button"
            type="button"
            class="w-full bg-[#164B35] hover:bg-[#103B2A] !text-[#FFFCF6] font-semibold py-4 rounded-xl transition text-center block cursor-pointer"
          >
            Calculate
          </button>

          <!-- Results -->
          <div class="bg-[#164B35] !text-[#FFFCF6] rounded-2xl p-6 md:p-8 space-y-6">

            <div>
              <span class="text-xs uppercase tracking-wider text-[#D5E4D9] font-semibold">
                Offset Advantage Analysis
              </span>
              <h3 class="text-lg font-bold !text-[#FFFCF6] mt-1">
                Tax-Adjusted Equivalent Return
              </h3>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">

              <div class="rounded-xl bg-[#103B2A] border border-white/15 p-5">
                <span class="text-xs text-[#D5E4D9] uppercase font-medium">
                  Annual Interest Saved
                </span>
                <div id="resAnnualSaved" class="text-2xl sm:text-3xl font-bold !text-[#FFFCF6] mt-2 tracking-tight">
                  —
                </div>
                <span class="text-xs text-[#E5EDE7] font-medium">
                  Guaranteed, tax-free cash back
                </span>
              </div>

              <div class="rounded-xl bg-[#103B2A] border border-white/15 p-5">
                <span class="text-xs text-[#D5E4D9] uppercase font-medium">
                  Pre-Tax Equivalent Return
                </span>
                <div id="resPreTaxReturn" class="text-2xl sm:text-3xl font-bold !text-[#E4CBA5] mt-2 tracking-tight">
                  —
                </div>
                <span class="text-xs text-[#E5EDE7] font-medium">
                  Required return in a standard taxed account
                </span>
              </div>

            </div>
          </div>

        </div>

        <!-- Formula Explanation -->
        <div class="bg-[#FFFCF6] border border-[#E3D8C8] rounded-2xl p-6 md:p-8 space-y-3">
          <h3 class="font-semibold text-[#18251F]">
            How is the pre-tax return calculated?
          </h3>
          <p class="text-sm text-[#626B64] leading-relaxed">
            Because investment earnings are taxed at your marginal rate, a standard investment must generate a higher return to match the risk-free, tax-free savings of an offset account. The formula used is:
          </p>
          <code class="inline-block bg-[#F8F3EA] px-3 py-2 rounded-lg text-[#164B35] font-mono text-sm">
            Interest Rate / (1 - Tax Rate)
          </code>
        </div>

        <div class="space-y-4">
          <p class="text-[#26312B] leading-relaxed text-lg">
            When you keep cash in a standard high-interest savings account, the interest earned counts toward your taxable income and gets chipped away by your marginal tax rate.
          </p>

          <p class="text-[#626B64] leading-relaxed">
            Money kept in an active <strong class="text-[#26312B]">mortgage offset account</strong> reduces the principal balance upon which your home loan interest is calculated. Because mortgage interest is paid with post-tax dollars, the savings you receive are effectively 100% tax-free. Enter your numbers below and click calculate to evaluate your true effective return.
          </p>
        </div>

      </div>

      <!-- Sidebar -->
      <aside class="lg:col-span-4 space-y-8 lg:sticky lg:top-28">

        <div class="bg-[#FFFCF6] border border-[#E3D8C8] rounded-2xl p-6 space-y-4 text-center">
          
        </div>

        <div class="bg-[#FFFCF6] border border-[#E3D8C8] rounded-2xl p-6 space-y-4">
          <h3 class="text-base font-bold !text-[#18251F] border-b border-[#E3D8C8] pb-3">
            Other Calculators
          </h3>

          <ul class="space-y-4 text-sm">
            <li>
              <a
                href="/calculators-and-tools/future-wealth-calculator"
                class="text-[#26312B] hover:text-[#164B35] font-medium transition block"
              >
                → Future Wealth Calculator
              </a>
            </li>

            <li>
              <a
                href="/calculators-and-tools/compound-interest-calculator"
                class="text-[#26312B] hover:text-[#164B35] font-medium transition block"
              >
                → Compound Interest Calculator
              </a>
            </li>

            <li>
              <a
                href="/calculators-and-tools/dividend-payment-calculator"
                class="text-[#26312B] hover:text-[#164B35] font-medium transition block"
              >
                → Dividend Payment Calculator
              </a>
            </li>
          </ul>
        </div>

      </aside>

    </div>
  </main>

  <script>
    function calculateOffset() {
      const principalInput = document.getElementById('principal') as HTMLInputElement;
      const interestRateInput = document.getElementById('interestRate') as HTMLInputElement;
      const taxRateInput = document.getElementById('taxRate') as HTMLInputElement;

      const resAnnualSaved = document.getElementById('resAnnualSaved');
      const resPreTaxReturn = document.getElementById('resPreTaxReturn');

      if (!principalInput || !interestRateInput || !taxRateInput || !resAnnualSaved || !resPreTaxReturn) return;

      const principal = parseFloat(principalInput.value) || 0;
      const interestRate = (parseFloat(interestRateInput.value) || 0) / 100;
      const taxRate = (parseFloat(taxRateInput.value) || 0) / 100;

      // Calculate annual interest saved
      const annualInterestSaved = principal * interestRate;

      // Calculate effective pre-tax return rate
      const effectivePreTaxReturnRate = taxRate >= 1 ? 0 : interestRate / (1 - taxRate);

      // Format and output results
      resAnnualSaved.textContent = new Intl.NumberFormat('en-AU', {
        style: 'currency',
        currency: 'AUD',
        maximumFractionDigits: 2
      }).format(annualInterestSaved);

      resPreTaxReturn.textContent = `${(effectivePreTaxReturnRate * 100).toFixed(2)}%`;
    }

    // Only attach event listener to button click (no auto-calc or load execution)
    const btn = document.getElementById('calculate-button');
    if (btn) {
      btn.addEventListener('click', calculateOffset);
    }
  </script>
</BaseLayout>
