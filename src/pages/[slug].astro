---
import { sanityClient } from '../lib/sanity';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleSidebar from '../components/ArticleSidebar.astro';
import { PortableText } from 'astro-portabletext';
import { Image } from 'astro:assets';
import ArticleImage from '../components/ArticleImage.astro';
import ArticleCallout from '../components/ArticleCallout.astro';
import ArticleYoutube from '../components/ArticleYoutube.astro';
import AuthorBio from '../components/AuthorBio.astro';


export async function getStaticPaths() {
  const articles = await sanityClient.fetch(`

  
    *[_type == "article" && defined(slug.current)]{
      "slug": slug.current
    }
  `);
  

  return articles.map((article: { slug: string }) => ({
    params: { slug: article.slug },
  }));
}




const { slug } = Astro.params;

const article = await sanityClient.fetch(
  `*[_type == "article" && slug.current == $slug][0]{
    title,
    subtitle,
    category,
    author,
"authorProfile": authorProfile->{
  name,
  bio,
  website,
  sameAs,
  "slug": slug.current,
  "imageUrl": image.asset->url
},
publishedAt,
    "dateModified": coalesce(dateModified, updatedDate),
    seoTitle,
    seoDescription,
    noIndex,
    readTimeMinutes,
    keyTakeaways,
    body,
    disclaimer,
    "imageUrl": heroImage.asset->url,
    heroImageAlt,
    "socialImageUrl": coalesce(
      socialImage.asset->url,
      heroImage.asset->url
    )
  }`,
  { slug }
);



if (!article) {
  return Astro.redirect('/404');
}

const portableTextComponents = {
  type: {
    articleImage: ArticleImage,
        articleCallout: ArticleCallout,
        articleYoutube: ArticleYoutube,
        

  },
};

const articleUrl = new URL(
  Astro.url.pathname,
  Astro.site
).href;

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  '@id': `${articleUrl}#article`,
  headline: article.title,
  description: article.seoDescription || article.subtitle,
  image: article.socialImageUrl
    ? [article.socialImageUrl]
    : undefined,
  datePublished: article.publishedAt,
  dateModified: article.dateModified || undefined,
  author: article.authorProfile
  ? {
      '@type': 'Person',
      '@id': `https://www.dadinvestor.com.au/authors/${article.authorProfile.slug}/#person`,
      name: article.authorProfile.name,
      url: article.authorProfile.website,
      image: article.authorProfile.imageUrl,
      sameAs: article.authorProfile.sameAs,
    }
  : {
      '@type': 'Organization',
      name: article.author || 'DadInvestor Team',
    },
  publisher: {
  '@id': 'https://www.dadinvestor.com.au/#organization',
},
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': articleUrl,
  },
  articleSection: article.category,
  inLanguage: 'en-AU',
};
---

<BaseLayout
  title={article.seoTitle || article.title}
  description={article.seoDescription || article.subtitle}
  image={article.socialImageUrl}
  imageAlt={article.heroImageAlt || article.title}
  noIndex={article.noIndex}
  type="article"
>

 <script
    type="application/ld+json"
    set:html={JSON.stringify(structuredData)}
  />

  <!-- Article Header -->
 

<!-- Article Header -->
<header class="article-header">
  <div class="article-header-inner">

    {article.category && (
      <p class="article-category">{article.category}</p>
    )}

    <h1>{article.title}</h1>

    {article.subtitle && (
      <p class="article-subtitle">{article.subtitle}</p>
    )}

    {article.readTimeMinutes && (
      <p class="article-reading-time">
        {article.readTimeMinutes} min read
      </p>
    )}

  </div>
</header>




  <!-- Article Content + Sidebar -->
<main class="article-main">
    <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_320px] gap-8 lg:items-start">

      <!-- Main Article Column -->
      <div class="space-y-8">

        {article.imageUrl && (
<div class="article-featured-image">          
    <Image
              src={article.imageUrl}
              alt={article.heroImageAlt || article.title}
              width={1200}
              height={675}
              loading="eager"
              fetchpriority="high"
              class="w-full h-full object-cover"
            />
          </div>
        )}

        {article.keyTakeaways?.filter((takeaway: string) => takeaway.trim()).length > 0 && (
          <div class="article-takeaways">

            <h2 class="text-xl font-bold mb-4">
              Key Takeaways
            </h2>

            <ul class="list-disc pl-6 space-y-2">
              {article.keyTakeaways
                .filter((takeaway: string) => takeaway.trim())
                .map((takeaway: string) => (
                  <li>{takeaway}</li>
                ))}
            </ul>

          </div>
        )}

        <div class="bg-white rounded-2xl border border-slate-200 p-8 shadow-sm">
  <div class="article-body">
    <PortableText
  value={article.body}
  components={portableTextComponents}
/>
  </div>
</div>

        {article.disclaimer && (
          <div class="text-sm text-slate-500 border-t border-slate-200 pt-6">
            {article.disclaimer}
          </div>
        )}
        
        {article.authorProfile && (
  <AuthorBio author={article.authorProfile} />
)}

      </div>


      <!-- Fixed Article Sidebar -->
      <div class="lg:sticky lg:top-6">
        <ArticleSidebar />
      </div>

    </div>

  </main>

</BaseLayout>


<style>
  /* Article header */

  .article-header {
    background: var(--di-cream);
    padding: 64px 24px 42px;
  }

  .article-header-inner {
    max-width: 900px;
    margin: 0 auto;
  }

  .article-category {
    color: var(--di-forest);
    font-size: 20px;
    font-weight: 600;
    margin-bottom: 22px;
  }

  .article-header h1 {
    font-family: var(--di-font-heading);
    font-size: clamp(2.8rem, 5.5vw, 4.5rem);
    line-height: 1.04;
    letter-spacing: -0.045em;
    font-weight: 600;
    color: var(--di-ink);
  }

  .article-subtitle {
    margin-top: 24px;
    max-width: 780px;
    font-size: 23px;
    line-height: 1.5;
    color: var(--di-body);
  }

  .article-reading-time {
    margin-top: 22px;
    font-size: 20px;
    color: var(--di-muted);
  }

  /* Main layout */

  .article-main {
    background: var(--di-cream);
    padding: 24px 24px 80px;
  }

  .article-main > div {
    max-width: 1200px;
    margin: 0 auto;
  }

  .article-featured-image {
    overflow: hidden;
    border-radius: 8px;
    background: var(--di-highlight);
    aspect-ratio: 16 / 9;
  }

  .article-featured-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Key takeaways */

  .article-takeaways {
    background: var(--di-paper);
    padding: 30px;
    border-radius: 8px;
    margin-top: 36px;
  }

  .article-takeaways h2 {
    font-family: var(--di-font-heading);
    font-size: 30px;
    margin-bottom: 20px;
  }

  .article-takeaways ul {
    padding-left: 26px;
    list-style: disc;
  }

  .article-takeaways li {
    font-size: 20px;
    line-height: 1.6;
    margin-bottom: 12px;
  }

  /* Article body */

  .article-content-panel {
    background: var(--di-paper);
    padding: 40px;
    border-radius: 8px;
    margin-top: 36px;
  }

  .article-body {
    max-width: 760px;
    margin: 0 auto;
    font-family: var(--di-font-body);
    font-size: 20px;
    line-height: 1.75;
    color: var(--di-body);
  }

  .article-body :global(p) {
    margin: 0 0 1.8rem;
  }

  .article-body :global(h2) {
    font-family: var(--di-font-heading);
    font-size: 36px;
    line-height: 1.15;
    font-weight: 600;
    color: var(--di-ink);
    margin: 3rem 0 1.2rem;
    letter-spacing: -0.035em;
  }

  .article-body :global(h3) {
    font-family: var(--di-font-heading);
    font-size: 30px;
    line-height: 1.2;
    font-weight: 600;
    color: var(--di-ink);
    margin: 2.5rem 0 1rem;
    letter-spacing: -0.025em;
  }

  .article-body :global(h4) {
    font-family: var(--di-font-heading);
    font-size: 24px;
    line-height: 1.3;
    font-weight: 600;
    color: var(--di-ink);
    margin: 2rem 0 1rem;
  }

  .article-body :global(ul),
  .article-body :global(ol) {
    padding-left: 28px;
    margin: 0 0 1.8rem;
  }

  .article-body :global(ul) {
    list-style: disc;
  }

  .article-body :global(ol) {
    list-style: decimal;
  }

  .article-body :global(li) {
    padding-left: 5px;
    margin-bottom: 12px;
  }

  .article-body :global(a) {
    color: var(--di-forest);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .article-body :global(strong) {
    font-weight: 600;
    color: var(--di-ink);
  }

  /* Disclaimer */

  .article-main .text-slate-500 {
    color: var(--di-muted);
    font-size: 18px;
    line-height: 1.6;
  }

  /* Mobile */

  @media (max-width: 800px) {
    .article-header {
      padding: 44px 22px 30px;
    }

    .article-main {
      padding: 16px 16px 56px;
    }

    .article-content-panel {
      padding: 24px 20px;
    }

    .article-body {
      font-size: 19px;
    }

    .article-body :global(h2) {
      font-size: 31px;
    }
  }
</style>
