---
// src/pages/[slug].astro
import { sanityClient } from '../lib/sanity';
import BaseLayout from '../layouts/BaseLayout.astro';
import { PortableText } from "astro-portabletext";
import { Image } from 'astro:assets';

// 1. Tell Astro which static slugs exist by fetching them from Sanity
export async function getStaticPaths() {
  const posts = await sanityClient.fetch(`*[_type == "post" && defined(slug.current)]{ "slug": slug.current }`);
  return posts.map((post: { slug: string }) => ({
    params: { slug: post.slug },
  }));
}

// 2. Fetch the specific article data based on the current URL slug
const { slug } = Astro.params;
const post = await sanityClient.fetch(
  `*[_type == "post" && slug.current == $slug][0]{
    title,
    excerpt,
    publishedAt,
    body,
    "imageUrl": mainImage.asset->url,
    "categoryTitle": category->title,
    "readTime": "6 min read"
  }`,
  { slug }
);

if (!post) {
  return Astro.redirect('/404');
}
---

<BaseLayout title={post.title} description={post.excerpt}>
  <header class="bg-[#0F291E] text-white py-16 px-4 border-b border-emerald-900/50">
    <div class="max-w-3xl mx-auto space-y-4">
      <div class="flex items-center gap-3">
        {post.categoryTitle && (
          <span class="bg-[#10B981]/20 text-[#10B981] font-semibold text-xs uppercase tracking-wider px-3 py-1 rounded-full border border-[#10B981]/30">
            {post.categoryTitle}
          </span>
        )}
        <span class="text-slate-400 text-sm">• {post.readTime}</span>
      </div>
      
      <h1 class="text-3xl md:text-5xl font-extrabold tracking-tight leading-tight text-white">
        {post.title}
      </h1>
    </div>
  </header>

  <main class="bg-[#F8FAFC] py-12 px-4">
    <div class="max-w-3xl mx-auto space-y-8">
      
      {post.imageUrl && (
        <div class="rounded-2xl overflow-hidden border border-slate-200 shadow-sm bg-white aspect-[16/9]">
          <Image 
            src={post.imageUrl} 
            alt={post.title} 
            width={1200} 
            height={675} 
            loading="eager"
            fetchpriority="high"
            class="w-full h-full object-cover"
          />
        </div>
      )}

      <div class="bg-white rounded-2xl border border-slate-200 p-8 shadow-sm prose prose-slate max-w-none">
        <PortableText value={post.body} />
      </div>

    </div>
  </main>
</BaseLayout>