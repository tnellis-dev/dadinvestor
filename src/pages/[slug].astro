---
import { sanityClient } from '../lib/sanity';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleSidebar from '../components/ArticleSidebar.astro';
import { PortableText } from 'astro-portabletext';
import { Image } from 'astro:assets';

export async function getStaticPaths() {
  const articles = await sanityClient.fetch(`
    *[_type == "article" && defined(slug.current)]{
      "slug": slug.current
    }
  `);

  return articles.map((article: { slug: string }) => ({
    params: { slug: article.slug },
  }));
}

const { slug } = Astro.params;

const article = await sanityClient.fetch(
  `*[_type == "article" && slug.current == $slug][0]{
    title,
    subtitle,
    category,
    author,
    updatedDate,
    readTimeMinutes,
    keyTakeaways,
    body,
    disclaimer,
    "imageUrl": heroImage.asset->url,
    heroImageAlt
  }`,
  { slug }
);

if (!article) {
  return Astro.redirect('/404');
}
---

<BaseLayout title={article.title} description={article.subtitle}>

  <!-- Article Header -->
  <header class="bg-[#0F291E] text-white py-16 px-4 border-b border-emerald-900/50">
<div class="max-w-6xl mx-auto">
  <div class="lg:w-[calc(100%-352px)] space-y-4">
          <div class="flex items-center gap-3">
        {article.category && (
          <span class="bg-[#10B981]/20 text-[#10B981] font-semibold text-xs uppercase tracking-wider px-3 py-1 rounded-full border border-[#10B981]/30">
            {article.category}
          </span>
        )}

        {article.readTimeMinutes && (
          <span class="text-slate-400 text-sm">
            • {article.readTimeMinutes} min read
          </span>
        )}
      </div>

      <h1 class="text-3xl md:text-5xl font-extrabold tracking-tight leading-tight text-white">
        {article.title}
      </h1>

      {article.subtitle && (
        <p class="text-lg text-slate-300">
          {article.subtitle}
        </p>
      )}

    </div>
  </div>
  </header>


  <!-- Article Content + Sidebar -->
  <main class="bg-[#F8FAFC] py-12 px-4">

    <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_320px] gap-8 lg:items-start">

      <!-- Main Article Column -->
      <div class="space-y-8">

        {article.imageUrl && (
          <div class="rounded-2xl overflow-hidden border border-slate-200 shadow-sm bg-white aspect-[16/9]">
            <Image
              src={article.imageUrl}
              alt={article.heroImageAlt || article.title}
              width={1200}
              height={675}
              loading="eager"
              fetchpriority="high"
              class="w-full h-full object-cover"
            />
          </div>
        )}

        {article.keyTakeaways?.filter((takeaway: string) => takeaway.trim()).length > 0 && (
          <div class="bg-white rounded-2xl border border-slate-200 p-8 shadow-sm">

            <h2 class="text-xl font-bold mb-4">
              Key Takeaways
            </h2>

            <ul class="list-disc pl-6 space-y-2">
              {article.keyTakeaways
                .filter((takeaway: string) => takeaway.trim())
                .map((takeaway: string) => (
                  <li>{takeaway}</li>
                ))}
            </ul>

          </div>
        )}

        <div class="bg-white rounded-2xl border border-slate-200 p-8 shadow-sm">
  <div class="article-body">
    <PortableText value={article.body} />
  </div>
</div>

        {article.disclaimer && (
          <div class="text-sm text-slate-500 border-t border-slate-200 pt-6">
            {article.disclaimer}
          </div>
        )}

      </div>


      <!-- Fixed Article Sidebar -->
      <div class="lg:sticky lg:top-6">
        <ArticleSidebar />
      </div>

    </div>

  </main>

</BaseLayout>

<style>
  .article-body {
  font-family: 'Work Sans', sans-serif;
  font-size: 18px;
  line-height: 1.65;
  color: #334155;
}

.article-body :global(p) {
  margin: 0 0 1.5rem;
}

.article-body :global(h2) {
  font-family: 'Poppins', sans-serif;
  font-size: 30px;
  line-height: 1.2;
  font-weight: 700;
  color: #0F291E;
  margin: 3rem 0 1rem;
}

.article-body :global(h3) {
  font-family: 'Poppins', sans-serif;
  font-size: 23px;
  line-height: 1.3;
  font-weight: 600;
  color: #0F291E;
  margin: 2.5rem 0 0.9rem;
}

.article-body :global(h4) {
  font-family: 'Poppins', sans-serif;
  font-size: 20px;
  line-height: 1.3;
  font-weight: 600;
  color: #0F291E;
  margin: 2rem 0 0.75rem;
}

.article-body :global(ul) {
  list-style-type: disc;
  padding-left: 1.5rem;
  margin: 0 0 1.5rem;
}

.article-body :global(ol) {
  list-style-type: decimal;
  padding-left: 1.5rem;
  margin: 0 0 1.5rem;
}

.article-body :global(li) {
  padding-left: 0.25rem;
  margin-bottom: 0.6rem;
}

.article-body :global(a) {
  color: #0F291E;
  font-weight: 600;
  text-decoration: underline;
}

.article-body :global(strong) {
  font-weight: 700;
}
</style>