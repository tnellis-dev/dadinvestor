
---
import BaseLayout from '../layouts/BaseLayout.astro';
import { sanityClient } from '../lib/sanity';

const latestArticles = await sanityClient.fetch(`
  *[
    _type == "article" &&
    defined(slug.current) &&
    !(_id in path("drafts.**"))
  ] | order(publishedAt desc)[0...3] {
    title,
    subtitle,
    publishedAt,
    "slug": slug.current,
    "imageUrl": heroImage.asset->url,
    heroImageAlt
  }
`);

const homepageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": "https://www.dadinvestor.com.au/#homepage",
  "url": "https://www.dadinvestor.com.au/",
  "name": "Australian Investing Guides & Financial Calculators | DadInvestor",
  "description": "Learn about investing, compare Australian ETFs and savings accounts, and use free financial calculators to make smarter decisions about your money.",
  "isPartOf": {
    "@id": "https://www.dadinvestor.com.au/#website"
  },
  "about": {
    "@id": "https://www.dadinvestor.com.au/#organization"
  },
  "inLanguage": "en-AU"
};



---

<BaseLayout
  title="Australian Investing Guides & Financial Calculators"
  description="Learn about investing, compare Australian ETFs and savings accounts, and use free financial calculators to make smarter decisions about your money."
>
  <main>

    <!-- Hero -->
    <section class="hero-section">
      <div class="hero-inner">

        <div class="hero-copy">
          <h1>
            Practical money<br class="hidden sm:block" />
            ideas for a<br class="hidden sm:block" />
            <em>richer life.</em>
          </h1>

          <div class="hero-underline"></div>

          <p class="hero-description">
            Investing, banking and financial decisions for everyday Australians,
            with a focus on building long-term wealth and more freedom for the
            things that matter.
          </p>

          <div class="hero-actions">
            <a href="/calculators-and-tools" class="button-primary">
              Explore the calculators
            </a>

            <a href="/articles" class="button-secondary">
              Read the latest articles
            </a>
          </div>
        </div>

        <div class="hero-portrait">
          <div class="portrait-frame">
            <img
              src="/images/tim-ellis.jpg"
              alt="Tim Ellis of DadInvestor"
              fetchpriority="high"
            />
          </div>
          <div class="portrait-scribble" aria-hidden="true"></div>
        </div>

      </div>
    </section>

    <!-- Latest articles -->
    <section class="content-section">
      <div class="section-heading">
        <h2>Latest articles</h2>
        <a href="/articles" class="section-link">
          View all articles <span aria-hidden="true">→</span>
        </a>
      </div>

      {latestArticles.length > 0 ? (
        <div class="article-grid">
          {latestArticles.map((article: any) => (
            <a href={`/${article.slug}`} class="article-card">
              {article.imageUrl ? (
                <div class="article-image">
                  <img
                    src={article.imageUrl}
                    alt={article.heroImageAlt || article.title}
                    loading="lazy"
                  />
                </div>
              ) : (
                <div class="article-image article-image-placeholder"></div>
              )}

              <div class="article-card-content">
                <h3>{article.title}</h3>
                {article.subtitle && (
                  <p>{article.subtitle}</p>
                )}
              </div>
            </a>
          ))}
        </div>
      ) : (
        <p class="empty-articles">
          Explore our latest investing and personal finance guides.
        </p>
      )}
    </section>

    <!-- Calculators -->
    <section class="calculator-section">
      <div class="content-section">
        <div class="section-heading">
          <h2>Tools for your financial future</h2>
          <a href="/calculators-and-tools" class="section-link">
            View all calculators <span aria-hidden="true">→</span>
          </a>
        </div>

        <div class="calculator-grid">

          <a
            href="/calculators-and-tools/future-wealth-calculator"
            class="calculator-card"
          >
            <h3>Future Wealth Calculator</h3>
            <p>
              Project your 30-year net worth combining super, ETFs,
              property and debt.
            </p>
            <span>Explore calculator →</span>
          </a>

          <a
            href="/calculators-and-tools/mortgage-offset-calculator"
            class="calculator-card"
          >
            <h3>Mortgage vs. Invest</h3>
            <p>
              Calculate whether extra cash is better off in your
              offset account or invested.
            </p>
            <span>Explore calculator →</span>
          </a>

          <a
            href="/calculators-and-tools/compound-interest-calculator"
            class="calculator-card"
          >
            <h3>Compound Interest Calculator</h3>
            <p>
              See how regular contributions and investment growth
              can build wealth over time.
            </p>
            <span>Explore calculator →</span>
          </a>

        </div>
      </div>
    </section>

    <!-- About -->
    <section class="about-section">
      <div class="about-inner">
        <h2>Money is a means to a richer life.</h2>
        <p>
          DadInvestor is an independent Australian resource for people
          who want to make better financial decisions. Practical guides,
          useful tools and clear thinking about building long-term wealth
          and creating more freedom.
        </p>
        <a href="/about" class="button-secondary">
          More about DadInvestor
        </a>
      </div>
    </section>

  </main>
</BaseLayout>

<style>
  .hero-section {
    background: var(--di-cream);
    padding: 72px 24px 88px;
  }

  .hero-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    align-items: center;
    gap: 64px;
  }

  .hero-copy h1 {
    font-family: var(--di-font-heading);
    font-size: clamp(3.5rem, 6.2vw, 5rem);
    font-weight: 600;
    letter-spacing: -0.055em;
    line-height: 0.99;
    color: var(--di-ink);
  }

  .hero-copy h1 em {
    font-style: italic;
  }

  .hero-underline {
    width: 205px;
    height: 6px;
    background: var(--di-forest);
    border-radius: 100%;
    transform: rotate(-3deg);
    margin-top: 14px;
  }

  .hero-description {
    max-width: 580px;
    margin-top: 24px;
    font-size: 22px;
    line-height: 1.5;
    color: var(--di-body);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: 38px;
  }

  .button-primary,
  .button-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 60px;
    padding: 14px 25px;
    border-radius: 999px;
    font-family: var(--di-font-heading);
    font-size: 20px;
    font-weight: 600;
    text-decoration: none;
    transition: background 180ms ease, color 180ms ease;
  }

  .button-primary {
    background: var(--di-forest);
    color: white;
  }

  .button-primary:hover {
    background: var(--di-forest-deep);
  }

  .button-secondary {
    border: 1px solid var(--di-line);
    color: var(--di-forest);
  }

  .button-secondary:hover {
    background: var(--di-highlight);
  }

  .hero-portrait {
    position: relative;
    max-width: 480px;
    margin: 0 auto;
    padding: 12px;
  }

  .portrait-frame {
    background: white;
    padding: 10px;
    box-shadow: 0 12px 25px rgb(40 35 25 / 12%);
    transform: rotate(5deg);
  }

  .portrait-frame img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: center 35%;
  }

  .portrait-scribble {
    position: absolute;
    width: 190px;
    height: 24px;
    right: -12px;
    bottom: -12px;
    border-top: 5px solid var(--di-forest);
    border-radius: 50%;
    transform: rotate(-12deg);
  }

  /* Content sections */

  .content-section {
    max-width: 1200px;
    margin: 0 auto;
    padding: 64px 24px 76px;
  }

  .section-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 34px;
  }

  .section-heading h2 {
    font-size: clamp(2.5rem, 4vw, 3.25rem);
    letter-spacing: -0.04em;
  }

  .section-link {
    flex-shrink: 0;
    color: var(--di-forest);
    font-family: var(--di-font-heading);
    font-size: 21px;
    font-weight: 600;
    text-decoration: none;
  }

  .section-link:hover {
    text-decoration: underline;
  }

  /* Articles */

  .article-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 28px;
  }

  .article-card {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .article-image {
    overflow: hidden;
    border-radius: 7px;
    aspect-ratio: 1.55 / 1;
    background: var(--di-highlight);
  }

  .article-image img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    transition: transform 350ms ease;
  }

  .article-card:hover .article-image img {
    transform: scale(1.035);
  }

  .article-card-content {
    padding: 20px 6px;
  }

  .article-card h3 {
    font-size: 29px;
    line-height: 1.15;
    letter-spacing: -0.025em;
    transition: color 180ms ease;
  }

  .article-card:hover h3 {
    color: var(--di-forest);
  }

  .article-card p {
    margin-top: 10px;
    font-size: 18px;
    line-height: 1.5;
    color: var(--di-muted);
  }

  .empty-articles {
    font-size: 20px;
  }

  /* Calculators */

  .calculator-section {
    background: var(--di-paper);
  }

  .calculator-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }

  .calculator-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 30px;
    border: 1px solid var(--di-line);
    border-radius: 10px;
    color: inherit;
    text-decoration: none;
    transition: border-color 180ms ease, transform 180ms ease;
  }

  .calculator-card:hover {
    border-color: var(--di-forest);
    transform: translateY(-3px);
  }

  .calculator-card h3 {
    font-size: 27px;
    line-height: 1.15;
  }

  .calculator-card p {
    margin-top: 14px;
    font-size: 19px;
    line-height: 1.5;
    color: var(--di-muted);
  }

  .calculator-card span {
    margin-top: 24px;
    color: var(--di-forest);
    font-size: 20px;
    font-weight: 600;
  }

  /* About */

  .about-section {
    padding: 80px 24px;
    background: var(--di-forest);
    color: white;
  }

  .about-inner {
    max-width: 800px;
    margin: 0 auto;
    text-align: center;
  }

  .about-inner h2 {
    color: white;
    font-size: clamp(2.5rem, 4vw, 3.5rem);
  }

  .about-inner p {
    margin: 24px auto 32px;
    font-size: 21px;
    line-height: 1.6;
    color: #F0F4EF;
  }

  .about-inner .button-secondary {
    border-color: rgb(255 255 255 / 45%);
    color: white;
  }

  .about-inner .button-secondary:hover {
    background: rgb(255 255 255 / 10%);
  }

  /* Responsive */

  @media (max-width: 800px) {
    .hero-section {
      padding: 52px 22px 64px;
    }

    .hero-inner {
      grid-template-columns: 1fr;
      gap: 52px;
    }

    .hero-copy h1 {
      font-size: clamp(3.2rem, 11vw, 4.5rem);
    }

    .hero-description {
      font-size: 20px;
    }

    .hero-portrait {
      width: 85%;
    }

    .article-grid,
    .calculator-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 560px) {
    .hero-actions {
      flex-direction: column;
    }

    .hero-actions a {
      width: 100%;
    }

    .section-heading {
      align-items: flex-start;
      flex-direction: column;
      gap: 12px;
    }

    .article-grid,
    .calculator-grid {
      grid-template-columns: 1fr;
    }

    .article-card h3 {
      font-size: 27px;
    }

    .content-section {
      padding-top: 48px;
      padding-bottom: 56px;
    }

    .hero-portrait {
      width: 90%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .article-image img,
    .calculator-card {
      transition: none;
    }
  }
</style>
