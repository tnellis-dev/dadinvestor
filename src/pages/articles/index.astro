
---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sanityClient } from '../../lib/sanity';

// Fetch all published articles from Sanity
const articles = await sanityClient.fetch(`
  *[
    _type == "article" &&
    defined(slug.current) &&
    !(_id in path("drafts.**"))
  ] | order(publishedAt desc) {
    title,
    subtitle,
    category,
    "slug": slug.current,
    publishedAt,
    dateModified,
    readTimeMinutes,
    featured,
    heroImageAlt,
    "imageUrl": heroImage.asset->url
  }
`);

// Featured article (newest featured article, or latest article as fallback)
const featuredArticle =
  articles.find((article) => article.featured) || articles[0];

// All remaining articles
const regularArticles = articles.filter(
  (article) => article.slug !== featuredArticle?.slug
);

// Format dates for display
const formatDate = (date) => {
  if (!date) return '';

  return new Date(date).toLocaleDateString('en-AU', {
    month: 'long',
    year: 'numeric',
  });
};

// Structured data
const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Guides, Reviews & Practical Education',
  description:
    'Explore our complete library of independent Australian financial guides, ETF comparisons, digital bank reviews, and practical wealth strategies.',
  url: 'https://www.dadinvestor.com.au/articles/',
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: articles.map((article, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: article.title,
      url: `https://www.dadinvestor.com.au/${article.slug}/`,
    })),
  },
};
---

<BaseLayout
  title="All Guides, Reviews & Articles - Dad Investor"
  description="Explore our complete library of independent Australian financial guides, ETF comparisons, digital bank reviews, and practical wealth strategies."
>
  <script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />

  <!-- Hero -->
  <header class="bg-[#164B35] text-white py-16 px-4">
    <div class="max-w-[1168px] mx-auto space-y-5">
      <p class="text-sm font-medium tracking-wide text-[#EAE2D5]">
        Independent financial education
      </p>

      <h1 class="text-4xl md:text-5xl font-semibold tracking-tight leading-tight !text-[#FFFCF6] max-w-4xl">
        Guides, Reviews & Practical Education
      </h1>

      <p class="text-lg leading-relaxed text-[#EAE2D5] max-w-2xl">
        Clear, independent guides to investing, banking and building wealth.
        Practical information to help you make better financial decisions.
      </p>
    </div>
  </header>

  <main class="bg-[#F8F3EA] py-16 px-4">
    <div class="max-w-[1168px] mx-auto space-y-16">

      <!-- Featured Article -->
      {featuredArticle && (
        <section>
          <a
            href={`/${featuredArticle.slug}`}
            class="group grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 items-center"
          >
            <div class="space-y-5">
              <p class="text-sm font-semibold text-[#164B35] tracking-wide">
                Featured article
              </p>

              <h2 class="text-3xl md:text-4xl font-semibold leading-tight text-[#18251F] group-hover:text-[#164B35] transition">
                {featuredArticle.title}
              </h2>

              {featuredArticle.subtitle && (
                <p class="text-lg leading-relaxed text-[#626B64]">
                  {featuredArticle.subtitle}
                </p>
              )}

              <div class="flex flex-wrap items-center gap-3 text-sm text-[#626B64]">
                {featuredArticle.category && (
                  <span>{featuredArticle.category}</span>
                )}

                {featuredArticle.readTimeMinutes && (
                  <>
                    <span>·</span>
                    <span>{featuredArticle.readTimeMinutes} min read</span>
                  </>
                )}

                {featuredArticle.publishedAt && (
                  <>
                    <span>·</span>
                    <span>{formatDate(featuredArticle.publishedAt)}</span>
                  </>
                )}
              </div>

              <span class="inline-flex items-center gap-2 font-semibold text-[#164B35]">
                Read article
                <span class="transition-transform group-hover:translate-x-1">→</span>
              </span>
            </div>

            {featuredArticle.imageUrl && (
              <div class="aspect-[16/10] overflow-hidden bg-[#EAE2D5]">
                <img
                  src={featuredArticle.imageUrl}
                  alt={featuredArticle.heroImageAlt || featuredArticle.title}
                  width="1200"
                  height="750"
                  fetchpriority="high"
                  class="w-full h-full object-cover transition duration-500 group-hover:scale-[1.02]"
                />
              </div>
            )}
          </a>
        </section>
      )}

      <div class="border-t border-[#E3D8C8]"></div>

      <!-- Article Library -->
      <section class="space-y-8">

        <div class="space-y-3">
          <h2 class="text-3xl font-semibold text-[#18251F]">
            Explore the library
          </h2>

          <p class="text-lg text-[#626B64]">
            Browse the latest guides, comparisons and reviews.
          </p>
        </div>

        <!-- Category Filters -->
        <div class="flex flex-wrap gap-3" aria-label="Filter articles">
          <button
            type="button"
            class="article-filter active-filter"
            data-filter="all"
            aria-pressed="true"
          >
            All articles
          </button>

          <button
            type="button"
            class="article-filter"
            data-filter="ETFs & Investing"
            aria-pressed="false"
          >
            ETFs & Investing
          </button>

          <button
            type="button"
            class="article-filter"
            data-filter="Banking & Savings"
            aria-pressed="false"
          >
            Banking & Savings
          </button>
        </div>

        <!-- Article Count -->
        <p
          id="article-count"
          class="text-sm text-[#626B64]"
          aria-live="polite"
        >
          {regularArticles.length} articles
        </p>

        <!-- Articles Grid -->
        {regularArticles.length > 0 ? (
          <div
            id="article-grid"
            class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-12"
          >
            {regularArticles.map((article) => (
              <article
                class="article-item group"
                data-category={article.category || ''}
              >
                <a href={`/${article.slug}`} class="block space-y-4">

                  {article.imageUrl ? (
                    <div class="aspect-[16/10] overflow-hidden bg-[#EAE2D5]">
                      <img
                        src={article.imageUrl}
                        alt={article.heroImageAlt || article.title}
                        width="800"
                        height="500"
                        loading="lazy"
                        class="w-full h-full object-cover transition duration-500 group-hover:scale-[1.02]"
                      />
                    </div>
                  ) : (
                    <div class="aspect-[16/10] bg-[#EAE2D5]"></div>
                  )}

                  <div class="space-y-3">

                    <div class="flex flex-wrap items-center gap-2 text-sm text-[#626B64]">
                      {article.category && (
                        <span class="font-medium text-[#164B35]">
                          {article.category}
                        </span>
                      )}

                      {article.readTimeMinutes && (
                        <>
                          <span>·</span>
                          <span>{article.readTimeMinutes} min read</span>
                        </>
                      )}
                    </div>

                    <h3 class="text-xl font-semibold leading-snug text-[#18251F] group-hover:text-[#164B35] transition">
                      {article.title}
                    </h3>

                    {article.subtitle && (
                      <p class="text-base leading-relaxed text-[#626B64] line-clamp-3">
                        {article.subtitle}
                      </p>
                    )}

                    <p class="text-sm font-semibold text-[#164B35]">
                      Read article →
                    </p>

                  </div>
                </a>
              </article>
            ))}
          </div>
        ) : (
          <p class="text-[#626B64]">
            No articles have been published yet.
          </p>
        )}

        <p
          id="no-articles"
          class="hidden text-[#626B64] py-8"
        >
          No articles found in this category.
        </p>

      </section>
    </div>
  </main>

  <style>
    .article-filter {
      padding: 10px 18px;
      border: 1px solid #E3D8C8;
      color: #26312B;
      background: transparent;
      font-size: 15px;
      font-weight: 500;
      transition: all 0.2s ease;
    }

    .article-filter:hover {
      border-color: #164B35;
      color: #164B35;
    }

    .article-filter.active-filter {
      background: #164B35;
      border-color: #164B35;
      color: #FFFCF6;
    }
  </style>

  <script>
    const filterButtons = document.querySelectorAll('.article-filter');
    const articleItems = document.querySelectorAll('.article-item');
    const articleCount = document.querySelector('#article-count');
    const noArticles = document.querySelector('#no-articles');

    filterButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const selectedCategory = button.getAttribute('data-filter');
        let visibleCount = 0;

        filterButtons.forEach((item) => {
          const isActive = item === button;

          item.classList.toggle('active-filter', isActive);
          item.setAttribute('aria-pressed', String(isActive));
        });

        articleItems.forEach((article) => {
          const category = article.getAttribute('data-category');

          const isVisible =
            selectedCategory === 'all' ||
            category === selectedCategory;

          article.classList.toggle('hidden', !isVisible);

          if (isVisible) visibleCount++;
        });

        if (articleCount) {
          articleCount.textContent =
            `${visibleCount} ${visibleCount === 1 ? 'article' : 'articles'}`;
        }

        if (noArticles) {
          noArticles.classList.toggle('hidden', visibleCount > 0);
        }
      });
    });
  </script>
</BaseLayout>
