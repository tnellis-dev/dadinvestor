---
// src/pages/articles/index.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';

// Article data array (Replaced by Sanity GROQ query in production)
const articles = [
  {
    slug: 'best-etf-in-australia',
    title: 'Best ETFs in Australia (2026 Guide for Everyday Investors)',
    category: 'ETFs & Investing',
    readTime: '8 min read',
    updatedDate: 'August 2026',
    excerpt: 'Looking for the best exchange-traded funds to build long-term wealth? Here is our plain-English breakdown of core ASX index funds, fees, and strategy for Aussie parents.',
    featured: true,
    image: 'https://images.unsplash.com/photo-1559526324-4b87b5e36e44?auto=format&fit=crop&w=1200&q=80',
  },
  {
    slug: 'ubank-vs-up-bank',
    title: 'Ubank vs Up Bank: Which Digital Bank Wins in 2026?',
    category: 'Banking & Savings',
    readTime: '6 min read',
    updatedDate: 'August 2026',
    excerpt: 'Comparing high-interest savings rates, app features, budgeting tools, and everyday transaction accounts between two of Australia’s favourite neobanks.',
    featured: false,
    image: 'https://images.unsplash.com/photo-1563986768609-322da13575f3?auto=format&fit=crop&w=800&q=80',
  },
  {
    slug: 'raiz-review',
    title: 'Raiz Review: Is Micro-Investing Worth It in Australia?',
    category: 'App Reviews',
    readTime: '5 min read',
    updatedDate: 'August 2026',
    excerpt: 'An independent, jargon-free review of Raiz micro-investing. Look at fees, portfolio performance history, and whether it fits your family budget.',
    featured: false,
    image: 'https://images.unsplash.com/photo-1579621970563-ebec7560ff3e?auto=format&fit=crop&w=800&q=80',
  },
  {
    slug: 'macquarie-bank-review',
    title: 'Macquarie Savings Account Review: High Rates with No Conditions',
    category: 'Banking & Savings',
    readTime: '5 min read',
    updatedDate: 'July 2026',
    excerpt: 'Why Macquarie Bank has become a top choice for Aussies looking for unconditional high-interest savings rates and smooth transaction features.',
    featured: false,
    image: 'https://images.unsplash.com/photo-1559526324-4b87b5e36e44?auto=format&fit=crop&w=800&q=80',
  },
  {
    slug: 'betashares-kids-accounts',
    title: 'BetaShares Direct Kids Accounts: Best Way to Invest for Children?',
    category: 'ETFs & Investing',
    readTime: '7 min read',
    updatedDate: 'July 2026',
    excerpt: 'Breaking down tax implications, minor trust structures, fee models, and long-term compounding options when investing for your kids in Australia.',
    featured: false,
    image: 'https://images.unsplash.com/photo-1502086223501-7ea6ecd79368?auto=format&fit=crop&w=800&q=80',
  },
  {
    slug: 'commsec-pockets-review',
    title: 'CommSec Pocket Review: Cheap ASX Micro-Investing App?',
    category: 'App Reviews',
    readTime: '6 min read',
    updatedDate: 'June 2026',
    excerpt: 'Is CommSec Pocket the cheapest way to trade ETFs in Australia? We review trades, $2 brokerage fees, CHESS sponsorship, and ETF themes.',
    featured: false,
    image: 'https://images.unsplash.com/photo-1611974789855-9c2a0a7236a3?auto=format&fit=crop&w=800&q=80',
  },
  {
    slug: 'google-sheets-vs-sharesight',
    title: 'Google Sheets vs Sharesight: How Should You Track ETF Returns?',
    category: 'Tools & Tracking',
    readTime: '6 min read',
    updatedDate: 'May 2026',
    excerpt: 'Comparing automated dividend tracking, dividend reinvestment plans (DRP), tax reporting, and cost between Sharesight and custom spreadsheets.',
    featured: false,
    image: 'https://images.unsplash.com/photo-1460925895917-afdab827c52f?auto=format&fit=crop&w=800&q=80',
  }
];

const featuredArticle = articles.find((a) => a.featured) || articles[0];
const regularArticles = articles.filter((a) => a.slug !== featuredArticle.slug);
---

<BaseLayout 
  title="All Guides, Reviews & Articles - Dad Investor" 
  description="Explore our complete library of independent Australian financial guides, ETF comparisons, digital bank reviews, and practical wealth strategies."
>
  <!-- Header Banner -->
  <header class="bg-[#0F291E] text-white py-16 px-4 border-b border-emerald-900/50">
    <div class="max-w-7xl mx-auto space-y-4">
      <div class="flex items-center gap-3">
        <span class="bg-[#10B981]/20 text-[#10B981] font-semibold text-xs uppercase tracking-wider px-3 py-1 rounded-full border border-[#10B981]/30">
          Knowledge Base
        </span>
        <span class="text-slate-400 text-sm">• 100% Independent</span>
      </div>
      
      <h1 class="text-3xl md:text-5xl font-extrabold tracking-tight leading-tight text-white max-w-4xl">
        Guides, Reviews & Practical Education
      </h1>
      
      <p class="text-lg text-slate-300 leading-relaxed font-normal max-w-3xl">
        Cut through the corporate jargon. Search our complete directory of plain-English financial breakdowns designed for Aussie families.
      </p>
    </div>
  </header>

  <main class="bg-[#F8FAFC] py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto space-y-12">

      <!-- Featured Article Callout Card -->
      <section>
        <a 
          href={`/${featuredArticle.slug}`} 
          class="group grid grid-cols-1 lg:grid-cols-12 gap-8 bg-white rounded-3xl border border-slate-200 p-6 lg:p-8 shadow-sm hover:shadow-md transition items-center"
        >
          <div class="lg:col-span-7 space-y-4">
            <div class="flex items-center gap-3">
              <span class="bg-emerald-50 text-[#10B981] font-bold text-xs uppercase tracking-wider px-3 py-1 rounded-full border border-emerald-100">
                Featured Guide
              </span>
              <span class="text-slate-500 text-xs">• {featuredArticle.readTime}</span>
            </div>
            
            <h2 class="text-2xl sm:text-3xl font-extrabold text-[#0F291E] group-hover:text-[#10B981] transition">
              {featuredArticle.title}
            </h2>
            
            <p class="text-slate-600 text-base leading-relaxed">
              {featuredArticle.excerpt}
            </p>

            <div class="pt-2 text-sm font-bold text-[#0F291E] flex items-center gap-2">
              Read Complete Breakdown <span class="group-hover:translate-x-1 transition-transform">→</span>
            </div>
          </div>

          <div class="lg:col-span-5 rounded-2xl overflow-hidden aspect-[16/9] border border-slate-100 bg-slate-50">
            <Image 
              src={featuredArticle.image} 
              alt={featuredArticle.title} 
              width={1200} 
              height={675} 
              class="w-full h-full object-cover group-hover:scale-105 transition duration-300"
            />
          </div>
        </a>
      </section>

      <!-- All Articles Grid (2 Rows x 3 Columns = 6 Cards) -->
      <section class="space-y-6">
        <h2 class="text-2xl font-bold text-[#0F291E] tracking-tight">Recent Articles & Reviews</h2>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {regularArticles.map((article) => (
            <a 
              href={`/${article.slug}`} 
              class="group bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-sm hover:shadow-md hover:border-[#10B981]/50 transition flex flex-col justify-between"
            >
              <div>
                <div class="aspect-[16/9] overflow-hidden bg-slate-100 border-b border-slate-100">
                  <Image 
                    src={article.image} 
                    alt={article.title} 
                    width={800} 
                    height={450} 
                    loading="lazy"
                    class="w-full h-full object-cover group-hover:scale-105 transition duration-300"
                  />
                </div>

                <div class="p-6 space-y-3">
                  <div class="flex items-center justify-between text-xs">
                    <span class="font-bold text-[#10B981] uppercase tracking-wider bg-emerald-50 px-2.5 py-1 rounded-md border border-emerald-100">
                      {article.category}
                    </span>
                    <span class="text-slate-400">{article.readTime}</span>
                  </div>

                  <h3 class="text-lg font-bold text-[#0F291E] group-hover:text-[#10B981] transition leading-snug">
                    {article.title}
                  </h3>

                  <p class="text-slate-600 text-sm leading-relaxed line-clamp-3">
                    {article.excerpt}
                  </p>
                </div>
              </div>

              <div class="p-6 pt-0 text-sm font-semibold text-[#0F291E] flex items-center gap-1">
                Read Article <span class="group-hover:translate-x-1 transition-transform">→</span>
              </div>
            </a>
          ))}
        </div>
      </section>

    </div>
  </main>
</BaseLayout>