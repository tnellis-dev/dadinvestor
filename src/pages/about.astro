
---
import BaseLayout from '../layouts/BaseLayout.astro';

const aboutStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  '@id': 'https://www.dadinvestor.com.au/about/#about',
  name: 'About Tim - DadInvestor',
  description: 'I help Financial DIYers own their money and future through plain-English education and simple financial tools.',
  url: 'https://www.dadinvestor.com.au/about/',
  isPartOf: {
    '@id': 'https://www.dadinvestor.com.au/#website',
  },
  about: {
    '@id': 'https://www.dadinvestor.com.au/#organization',
  },
};
---

<BaseLayout
  title="About Tim - Dad Investor"
  description="I help Financial DIYers own their money and future through plain-English education and simple financial tools."
>
  <script
    type="application/ld+json"
    set:html={JSON.stringify(aboutStructuredData)}
  />

  <main class="bg-[#F8F3EA] min-h-screen px-4 py-16 md:py-24">
    <article class="max-w-[760px] mx-auto space-y-10">

      <header class="space-y-6">
        <h1 class="text-4xl sm:text-5xl md:text-6xl font-semibold tracking-tight leading-tight !text-[#18251F]">
          Hi, I'm Tim. I help Financial DIYers own their money and future.
        </h1>

        <img
          src="/images/tim-ellis.jpg"
          alt="Tim Ellis, founder of DadInvestor"
          class="w-full max-h-[420px] object-cover object-center rounded-sm"
          loading="eager"
          fetchpriority="high"
        />
      </header>

      <div class="space-y-6 text-lg leading-relaxed text-[#26312B]">

        <p class="text-xl font-medium !text-[#18251F]">
          Over the last 15 years, I've hit some major life milestones — marriage, kids, property investments, relocation, even dealing with redundancy.
        </p>

        <p>
          Along the way, I've learned that managing money isn't just about finding the best investment or chasing the highest return. It's about making decisions that give your family more choices and a little more freedom.
        </p>

        <p>
          I started DadInvestor to build the tools, calculators and guides I wished I'd had when figuring out offset accounts, compounding ETF returns and building long-term financial security for my family.
        </p>

        <p>
          I don't think you need to be an expert to take control of your finances. You need a clear understanding of the numbers, the confidence to question conventional thinking and a plan that makes sense for your life.
        </p>

      </div>

    </article>
  </main>
</BaseLayout>
