
---
import { sanityClient } from '../../lib/sanity';
import BaseLayout from '../../layouts/BaseLayout.astro';

const categoryInfo = {
  title: 'Banking & Savings',
  description:
    'Straightforward guides to Australian bank accounts, savings strategies, interest rates, and making your money work harder.',
};

// Fetch articles from Sanity
const articles = await sanityClient.fetch(`
  *[_type == "article" && category == "Banking & Savings"] | order(publishedAt desc) {
    title,
    subtitle,
    "slug": slug.current,
    publishedAt,
    dateModified,
    readTimeMinutes,
    featured,
    heroImage,
    heroImageAlt,
    "imageUrl": heroImage.asset->url
  }
`);

// Featured articles (maximum 3)
const featuredArticles = articles
  .filter((article) => article.featured)
  .slice(0, 3);

// Identify which articles are actually displayed as featured
const featuredSlugs = new Set(
  featuredArticles.map((article) => article.slug)
);

// Remaining articles, newest first
const latestArticles = articles.filter(
  (article) => !featuredSlugs.has(article.slug)
);

// Format dates
const formatDate = (date) => {
  if (!date) return '';

  return new Date(date).toLocaleDateString('en-AU', {
    month: 'long',
    year: 'numeric',
  });
};

// Structured data
const hubSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Banking & Savings',
  description: categoryInfo.description,
  url: 'https://www.dadinvestor.com.au/banking-savings/',
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: articles.map((article, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: article.title,
      url: `https://www.dadinvestor.com.au/${article.slug}`,
    })),
  },
};
---

<BaseLayout
  title="Banking & Savings Hub"
  description="Compare Australian bank accounts, learn how to maximise savings interest, and make smarter decisions with your money."
>

  <script type="application/ld+json" set:html={JSON.stringify(hubSchema)} />

  <!-- Hub Header Hero Banner -->
  <header class="bg-[#0F291E] text-white py-16 px-4 border-b border-emerald-900/50">
    <div class="max-w-7xl mx-auto space-y-4">
      <div class="flex items-center gap-3">
        <span class="bg-[#10B981]/20 text-[#10B981] font-semibold text-xs uppercase tracking-wider px-3 py-1 rounded-full border border-[#10B981]/30">
          Category Hub
        </span>
        <span class="text-slate-400 text-sm">Banking & Savings</span>
      </div>

      <h1 class="text-3xl md:text-5xl font-extrabold tracking-tight leading-tight text-white max-w-4xl">
        Banking & Savings
      </h1>

      <p class="text-lg text-slate-300 leading-relaxed font-normal max-w-3xl">
        Make your money work harder. Explore straightforward guides to Australian bank accounts, savings rates, banking products, and strategies for building a stronger financial foundation.
      </p>
    </div>
  </header>

  <!-- Main Content Area -->
  <main class="bg-[#F8FAFC] py-16 px-4">
    <div class="max-w-7xl mx-auto space-y-16">

      <!-- Featured Articles -->
      {featuredArticles.length > 0 && (
        <section class="space-y-6">
          <div>
            <p class="text-sm font-bold uppercase tracking-wider text-[#10B981]">
              Start here
            </p>
            <h2 class="text-2xl md:text-3xl font-bold text-[#0F291E]">
              Featured guides
            </h2>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 items-stretch">
            {featuredArticles.map((article) => (
              <article class="bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-sm hover:border-[#10B981]/50 transition flex flex-col justify-between">

                <div>
                  <!-- Article Image -->
                  <div class="aspect-[16/9] overflow-hidden bg-slate-100 border-b border-slate-100">
                    {article.imageUrl && (
                      <a href={`/${article.slug}`} class="block w-full h-full">
                        <img
                          src={article.imageUrl}
                          alt={article.heroImageAlt || article.title}
                          loading="lazy"
                          class="w-full h-full object-cover hover:scale-105 transition duration-500"
                        />
                      </a>
                    )}
                  </div>

                  <!-- Card Body -->
                  <div class="p-6 space-y-3">
                    <div class="flex items-center gap-2 flex-wrap">
                      {article.readTimeMinutes && (
                        <span class="text-xs font-semibold text-[#10B981] bg-emerald-50 px-2.5 py-1 rounded-md border border-emerald-100">
                          {article.readTimeMinutes} min read
                        </span>
                      )}

                      {article.publishedAt && (
                        <span class="text-xs text-slate-400">
                          {formatDate(article.publishedAt)}
                        </span>
                      )}
                    </div>

                    <h3 class="text-xl font-bold text-[#0F291E] leading-snug">
                      <a href={`/${article.slug}`} class="hover:text-[#10B981] transition">
                        {article.title}
                      </a>
                    </h3>

                    {article.subtitle && (
                      <p class="text-slate-600 text-sm leading-relaxed">
                        {article.subtitle}
                      </p>
                    )}
                  </div>
                </div>

                <!-- Card Footer -->
                <div class="p-6 pt-0">
                  <a
                    href={`/${article.slug}`}
                    class="inline-flex items-center gap-1.5 text-sm font-bold text-[#0F291E] hover:text-[#10B981] transition"
                  >
                    Read Full Guide →
                  </a>
                </div>

              </article>
            ))}
          </div>
        </section>
      )}

      <!-- Latest Articles -->
      <section class="space-y-6">
        <div>
          <p class="text-sm font-bold uppercase tracking-wider text-[#10B981]">
            Explore the library
          </p>
          <h2 class="text-2xl md:text-3xl font-bold text-[#0F291E]">
            Latest articles
          </h2>
        </div>

        {latestArticles.length > 0 ? (
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 items-stretch">
            {latestArticles.map((article) => (
              <article class="bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-sm hover:border-[#10B981]/50 transition flex flex-col justify-between">

                <div>
                  <!-- Article Image -->
                  <div class="aspect-[16/9] overflow-hidden bg-slate-100 border-b border-slate-100">
                    {article.imageUrl && (
                      <a href={`/${article.slug}`} class="block w-full h-full">
                        <img
                          src={article.imageUrl}
                          alt={article.heroImageAlt || article.title}
                          loading="lazy"
                          class="w-full h-full object-cover hover:scale-105 transition duration-500"
                        />
                      </a>
                    )}
                  </div>

                  <!-- Card Body -->
                  <div class="p-6 space-y-3">
                    <div class="flex items-center gap-2 flex-wrap">
                      {article.readTimeMinutes && (
                        <span class="text-xs font-semibold text-[#10B981] bg-emerald-50 px-2.5 py-1 rounded-md border border-emerald-100">
                          {article.readTimeMinutes} min read
                        </span>
                      )}

                      {article.publishedAt && (
                        <span class="text-xs text-slate-400">
                          {formatDate(article.publishedAt)}
                        </span>
                      )}
                    </div>

                    <h3 class="text-xl font-bold text-[#0F291E] leading-snug">
                      <a href={`/${article.slug}`} class="hover:text-[#10B981] transition">
                        {article.title}
                      </a>
                    </h3>

                    {article.subtitle && (
                      <p class="text-slate-600 text-sm leading-relaxed">
                        {article.subtitle}
                      </p>
                    )}
                  </div>
                </div>

                <!-- Card Footer -->
                <div class="p-6 pt-0">
                  <a
                    href={`/${article.slug}`}
                    class="inline-flex items-center gap-1.5 text-sm font-bold text-[#0F291E] hover:text-[#10B981] transition"
                  >
                    Read Full Guide →
                  </a>
                </div>

              </article>
            ))}
          </div>
        ) : (
          <p class="text-slate-500">
            More articles coming soon.
          </p>
        )}
      </section>

      <!-- Bottom Flagship Tool Banner -->
      <div class="bg-[#0F291E] text-white rounded-2xl p-8 md:p-10 border border-emerald-900/60 shadow-lg flex flex-col md:flex-row items-center justify-between gap-6">
        <div class="space-y-2 max-w-xl">
          <span class="text-xs uppercase tracking-wider text-[#10B981] font-bold">
            Interactive Tool
          </span>

          <h3 class="text-2xl font-bold tracking-tight text-white">
            Map Your Wealth in 3 Minutes
          </h3>

          <p class="text-sm text-slate-300 leading-relaxed">
            Test how regular monthly contributions can grow over a 10, 20, or 30-year horizon and see what your savings habits could mean for your financial future.
          </p>
        </div>

        <a
          href="/calculators-and-tools/future-wealth-calculator"
          class="shrink-0 bg-[#10B981] text-[#0F291E] font-bold px-6 py-3.5 rounded-xl hover:bg-emerald-400 transition shadow-sm text-center"
        >
          Launch Wealth Map →
        </a>
      </div>

    </div>
  </main>

</BaseLayout>
