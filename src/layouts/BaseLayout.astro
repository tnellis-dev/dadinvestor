---
// src/layouts/BaseLayout.astro
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css'; // <-- MAKE SURE THIS IMPORT IS HERE

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Independent Australian wealth building tools and guides." } = Astro.props;
---

<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | DadInvestor</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="bg-[#F8FAFC] text-slate-900 font-sans antialiased min-h-screen flex flex-col">
    
    <Header />

    <div class="flex-grow">
      <slot />
    </div>

    <Footer />

  </body>
</html>